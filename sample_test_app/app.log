_button = st.form_submit_button('Add Task')\n\nif submit_button:\n    add_task(conn, task_input)\n    st.success('Task added successfully!')\n    st.rerun()\n\n# Display tasks\nfor task_id, task, completed in fetch_all_tasks(conn):\n    col1, col2, col3 = st.columns([2,1,2])\n    with col1:\n        st.write(task)\n    with col2:\n        if st.button('Done', key=f'done_{task_id}'):\n            update_task_status(conn, task_id, True)\n            st.rerun()\n    with col3:\n        if st.button('Delete', key=f'delete_{task_id}'):\n            delete_task(conn, task_id)\n            st.rerun()\n"
